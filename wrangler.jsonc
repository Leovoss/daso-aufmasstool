{
  "name": "daso-aufmasstool",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": { "directory": "dist/client" },
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "daso-aufmass-eu", "database_id": "b7dcd995-d426-4809-bb1f-60ffe3d1513b" },
    { "binding": "PLAN_DB", "database_name": "daso-montageplanung", "database_id": "42f5d224-bb84-4fd2-a1f8-d6abfda88956" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "daso-aufmass-files-eu" }],
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "build": { "command": "pnpm run build" }
}
